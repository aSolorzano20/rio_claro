PORT=3000
NODE_ENV=development
DEMO_MODE=true

# Required in production. Generate with: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Optional local demo administrator; provide both values to enable the account.
BOOTSTRAP_ADMIN_NAME=Administrador Río Claro
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Microsoft Foundry. Without these values, POST /api/chat returns HTTP 502.
FOUNDRY_PROJECT_ENDPOINT=
FOUNDRY_AGENT_NAME=AgenteAtencionClientes
FOUNDRY_MODEL_DEPLOYMENT=
FOUNDRY_AGENT_INSTRUCTIONS=Eres un asistente de Río Claro; responde sobre ventas, inventario y servicio al cliente.
